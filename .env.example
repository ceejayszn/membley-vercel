# ============================================================
# Membley Adventist Church — Environment Configuration
# ============================================================
# INSTRUCTIONS:
#   1. Copy this file to .env.local for local development.
#   2. Set ALL values below — never leave defaults in production.
#   3. Never commit .env.local or any file containing real secrets.
#   4. For Vercel: set these via Vercel Dashboard → Project → Settings → Environment Variables.
#   5. For Render: set via Render Dashboard → Environment → Environment Variables.
#
# REQUIRED CREDENTIAL ROTATION:
#   If any of the following have been previously committed to git:
#     - DATABASE_URL / POSTGRES_URL
#     - SUPABASE_DB_PASSWORD
#     - BLOB_READ_WRITE_TOKEN
#     - ADMIN_AUTH_SECRET
#   ...you MUST rotate/regenerate them immediately via their respective dashboards.
#   See docs/SECURITY.md for rotation instructions.
# ============================================================

# ── Database ──────────────────────────────────────────────
# Supabase PostgreSQL connection (Vercel/Render production)
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase project reference (found in Supabase Dashboard → Project Settings)
SUPABASE_PROJECT_REF=your_project_ref_here

# Supabase DB password (set during project creation, or reset in Supabase Dashboard)
SUPABASE_DB_PASSWORD=your_supabase_db_password_here

# ── Vercel Blob Storage ───────────────────────────────────
# Blob read/write token (Vercel Dashboard → Storage → Blob → Token)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here

# ── Admin Authentication ──────────────────────────────────
# HMAC signing secret for persistent admin cookies (min 32 random characters)
# Generate with: php -r "echo bin2hex(random_bytes(32));"
ADMIN_AUTH_SECRET=your_minimum_32_character_random_secret_here

# ── Application Environment ───────────────────────────────
# Options: local | production
APP_ENV=local

# ── Email (Optional, for future notifications) ────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_smtp_password
# MAIL_FROM=noreply@membleyadventist.org
